  '/investments/plots/{plotId}/requests/subscription':
    get:
      tags:
        - 'Subscription Requests'
      summary: 'List Subscription Requests'
      description: "Paginated list of subscription requests, filtered via the entity `scopeFilter`.\n\n**Filters (query params):**\n- `id` - exact match (also accepts a comma-separated/array of ids)\n- `plot_id` - exact plot id (also accepts multiple)\n- `status` - exact match on status (also accepts multiple of them)\n- `request_type` - exact match\n- `version` - exact match\n- `created_by` - exact user id (also accepts multiple)\n- `from_date` - minimum `created_at` (inclusive)\n- `to_date` - maximum `created_at` (inclusive)\n\n**Sorting** via `sort_by[column]=asc|desc`: `id`, `plot_id`, `request_type`, `status`,\n`version`, `created_at` - default `created_at` desc if omitted.\n"
      security:
        -
          sanctumAuth: {  }
      parameters:
        -
          name: plotId
          in: path
          required: true
          schema:
            type: integer
        -
          name: page
          in: query
          required: false
          schema:
            type: integer
            default: 1
          description: 'Page number'
        -
          name: per_page
          in: query
          required: false
          schema:
            type: integer
            default: 10
          description: 'Items per page'
        -
          name: id
          in: query
          required: false
          schema:
            type: string
          description: 'Exact subscription request id (or comma-separated ids)'
        -
          name: status
          in: query
          required: false
          schema:
            $ref: '#/components/schemas/SubscriptionRequestStatus'
          description: 'Filter by request status (or comma-separated statuses)'
        -
          name: request_type
          in: query
          required: false
          schema:
            type: string
            enum:
              - subscription_request
          description: 'Filter by request type'
        -
          name: version
          in: query
          required: false
          schema:
            type: string
          description: 'Filter by version'
        -
          name: created_by
          in: query
          required: false
          schema:
            type: integer
          description: 'Filter by the user who created the request'
        -
          name: from_date
          in: query
          required: false
          schema:
            type: string
            format: date
          description: 'Minimum created date (inclusive)'
        -
          name: to_date
          in: query
          required: false
          schema:
            type: string
            format: date
          description: 'Maximum created date (inclusive)'
      responses:
        200:
          description: "Paginated list of subscription requests.\n**Notification hint:** no notification is fired for a plain list request.\n"
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { type: array, items: { $ref: '#/components/schemas/PlotSubscriptionRequestResource' } } } }
        401:
          $ref: '#/components/responses/Unauthenticated'
        500:
          $ref: '#/components/responses/InternalServerError'
    post:
      tags:
        - 'Subscription Requests'
      summary: 'Create a Subscription Request'
      description: "Creates a subscription request with status `pending_subscription_fee` and a pending\nfee transaction (fee: payment fee with code `subscription_request_code`,\ntransaction type `incoming`, status `pending`, attached to the request).\n\nThe passed body is stored as the request `payload` (with `plot_id` added server-side).\nNO dossier/facility/partners are created at this step - they are materialized later\nwhen the request is completed.\n\nFails with `422` if the plot does not exist in a subscribable status\n(`announced` / `subscribed`).\n\n**Notification fired:**\n`TransactionCreatedNotification` to all users with permission\n`financial.transactions.change-status`. See the module description for the payload shape.\n"
      security:
        -
          sanctumAuth: {  }
      parameters:
        -
          name: plotId
          in: path
          required: true
          schema:
            type: integer
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AddSubscriptionRequestRequest'
      responses:
        200:
          description: "Subscription request created (status `pending_subscription_fee`), including its\npending fee transaction.\n"
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { $ref: '#/components/schemas/PlotSubscriptionRequestResource' } } }
        400:
          $ref: '#/components/responses/BadRequest'
        401:
          $ref: '#/components/responses/Unauthenticated'
        404:
          $ref: '#/components/responses/NotFound'
        422:
          $ref: '#/components/responses/ValidationError'
        500:
          $ref: '#/components/responses/InternalServerError'
