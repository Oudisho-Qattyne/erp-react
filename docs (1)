          type: integer
          example: 1
        name:
          type: string
          example: 'Maintenance Fee'
        code:
          type: string
          example: MTN-001
        fee_value:
          type: number
          format: float
          example: 250.5
        fee_status:
          type: string
          enum:
            - active
            - archived
          example: active
        created_at:
          type: string
          format: date
          example: 16-07-2026
    TransactionDTO:
      type: object
      required:
        - transaction_value
        - transaction_type
        - transaction_status
        - transaction_currency_id
      properties:
        transaction_value:
          type: number
          format: float
          example: 250.5
        transaction_type:
          type: string
          enum:
            - incoming
            - outgoing
          example: incoming
        transaction_date:
          type: string
          format: date
          example: '2026-08-04'
          description: 'Optional. Defaults to the current date when omitted.'
        transaction_status:
          type: string
          enum:
            - pending
            - approved
            - canceled
          example: pending
        transaction_currency_id:
          type: string
          description: 'Code of the transaction currency (must exist in currencies).'
          example: SYP
        client_payed_amount:
          type: number
          format: float
          description: "Amount paid by the client. Must equal the transaction value converted to the base currency\nusing the latest applicable rate, otherwise the request fails with `422`.\nExample : transaction value `100` USD with a `USD -> SYP` rate of `13000` requires `1300000`.\n"
          example: 1300000
        reason:
          type: string
          nullable: true
          example: 'Monthly maintenance fee'
    ChangeTransactionStatusRequest:
      type: object
      required:
        - transaction_status
        - transaction_currency_id
        - client_payed_amount
      properties:
        transaction_status:
          type: string
          enum:
            - approved
            - canceled
          example: approved
        transaction_currency_id:
          type: string
          description: 'Code of the currency the client pays with on this status change (must exist in currencies). May differ from the transaction currency.'
          example: USD
        client_payed_amount:
          type: number
          format: float
          description: "Amount paid by the client, expressed in `transaction_currency_id`.\nOnce converted to the base currency, it must match the expected base amount of the transaction,\notherwise the request fails with `422`.\n"
          example: 250.5
    TransactionInfoResource:
      type: object
      properties:
        id:
          type: string
          format: uuid
          example: 0198b4a2-7f1e-7f92-a3d1-2c6f4a9e5b10
        transaction_type:
          type: string
          enum:
            - incoming
            - outgoing
          example: incoming
        transaction_status:
          type: string
          enum:
            - pending
            - approved
            - canceled
          example: pending
        transaction_value:
          type: number
          format: float
          example: 250.5
        client_payed_amount:
          type: number
          format: float
          nullable: true
          description: 'Amount paid by the client (in `transaction_currency_id`).'
          example: 3256500
        exchange_rate_id:
          type: integer
          nullable: true
          description: 'ID of the exchange rate record used. Null when the transaction currency equals the base currency.'
          example: 4
        exchange_rate:
          type: number
          format: double
          nullable: true
          description: 'Applied conversion rate (1.0 when transaction currency equals the base currency).'
          example: 13000.0
        transaction_currency_id:
          type: string
          nullable: true
          description: 'Code of the transaction currency.'
          example: USD
        transaction_date:
          type: string
          format: date
          example: '2026-08-04'
        formatted_transaction_date:
