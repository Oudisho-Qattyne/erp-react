      summary: 'List all roles'
      tags:
        - 'Users Module'
      security:
        -
          sanctumAuth: {  }
      parameters:
        -
          in: query
          name: 'sort_by[id]'
          schema:
            type: string
            enum:
              - asc
              - desc
          description: 'Sort by role ID'
        -
          in: query
          name: 'sort_by[name]'
          schema:
            type: string
            enum:
              - asc
              - desc
            example: asc
          description: 'Sort by role name'
        -
          in: query
          name: 'sort_by[number_of_users]'
          schema:
            type: string
            enum:
              - asc
              - desc
            example: desc
          description: 'Sort by the number of users assigned to the role'
        -
          in: query
          name: 'sort_by[created_at]'
          schema:
            type: string
            enum:
              - asc
              - desc
            example: desc
          description: 'Sort by creation date. Defaults to `desc` when no `sort_by` is provided.'
      responses:
        200:
          description: 'List of roles'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { type: array, items: { $ref: '#/components/schemas/Role' } } } }
        401:
          $ref: '#/components/responses/Unauthenticated'
        403:
          $ref: '#/components/responses/Forbidden'
  /users/roles/store:
    post:
      summary: 'Create a new role'
      tags:
        - 'Users Module'
      security:
        -
          sanctumAuth: {  }
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - name
                - display_name
              properties:
                name:
                  type: string
                display_name:
                  type: string
                permissions:
                  type: array
                  items: { type: string }
      responses:
        200:
          description: 'Role created successfully'
        401:
          $ref: '#/components/responses/Unauthenticated'
        403:
          $ref: '#/components/responses/Forbidden'
        422:
          description: 'Validation error'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ValidationErrorResponse'
  '/users/roles/{id}':
    get:
      summary: 'Get role details'
      tags:
        - 'Users Module'
      security:
        -
          sanctumAuth: {  }
      parameters:
        -
          name: id
          in: path
          required: true
          schema:
            type: string
      responses:
        200:
          description: 'Role details'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { $ref: '#/components/schemas/Role' } } }
        401:
          $ref: '#/components/responses/Unauthenticated'
        403:
          $ref: '#/components/responses/Forbidden'
    post:
      summary: 'Update a role'
      tags:
        - 'Users Module'
      security:
        -
          sanctumAuth: {  }
      parameters:
        -
          name: id
          in: path
          required: true
          schema:
            type: string
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                name:
                  type: string
                display_name:
                  type: string
                permissions:
                  type: array
                  items: { type: string }
      responses:
        200:
          description: 'Role updated successfully'
        401:
          $ref: '#/components/responses/Unauthenticated'
        403:
          $ref: '#/components/responses/Forbidden'
        422:
          description: 'Validation error'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ValidationErrorResponse'
    delete:
      summary: 'Delete a role'
      tags:
        - 'Users Module'
      security:
        -
          sanctumAuth: {  }
      parameters:
        -
          name: id
          in: path
          required: true
          schema:
            type: string
      responses:
        200:
          description: 'Role deleted successfully'
        401:
          $ref: '#/components/responses/Unauthenticated'
        403:
          $ref: '#/components/responses/Forbidden'
components:
  securitySchemes:
    sanctumAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
  schemas:
    Notification:
      type: object
      description: 'A database notification stored in the `notifications` table.'
      properties:
        id:
          type: string
          format: uuid
          example: 4b1f1e7a-9f6b-4a1c-8a2e-3f5d7c9b2e41
        type:
          type: string
          description: 'Fully-qualified class name of the notification.'
          example: App\Modules\Investments\Notifications\SubscriptionRequestCreated
        notifiable_type:
          type: string
          example: App\Modules\UserManagement\Domain\Entities\User
        notifiable_id:
          type: integer
          example: 1
        data:
          type: object
          description: 'Notification payload built by `DatabaseNotificationPayloadBuilder`.'
          properties:
            title:
              type: string
              example: 'New subscription request'
            content:
              type: object
              additionalProperties: true
              example:
                dossier_id: 15
                message: 'A new subscription request was submitted'
            notification_type:
              type: string
              example: App\Modules\Investments\Notifications\SubscriptionRequestCreated
        read_at:
          type: string
          format: date-time
          nullable: true
          example: '2026-08-12T10:00:00.000000Z'
        created_at:
          type: string
          format: date-time
          example: '2026-08-12T09:30:00.000000Z'
        updated_at:
          type: string
          format: date-time
          example: '2026-08-12T09:30:00.000000Z'
    SuccessResponse:
      type: object
      properties:
        status:
          type: string
          example: Success
        plan:
          type: string
          nullable: true
          example: null
        data:
          type: object
    SuccessResponseEmptyData:
      type: object
      properties:
        status:
          type: string
          example: Success
        plan:
          type: string
          nullable: true
          example: null
        data:
          type: array
          example: {  }
    ErrorResponse:
      type: object
      properties:
        status:
          type: string
          example: Error
        message:
          type: string
          example: 'An error occurred'
        data:
          type: array
          example: {  }
    ValidationErrorResponse:
      type: object
      properties:
        status:
          type: string
          example: Error
        message:
          type: string
          example: 'validation errors'
        data:
          type: string
          nullable: true
          example: null
        validationErrors:
          type: object
          additionalProperties:
            type: string
    Country:
