          type: integer
          example: 1
        sender_id:
          type: integer
          example: 1
        receiver_id:
          type: integer
          example: 2
        sender:
          $ref: '#/components/schemas/ChatUser'
        receiver:
          $ref: '#/components/schemas/ChatUser'
        body:
          type: string
          example: 'Hello, how are you?'
        read_at:
          type: string
          nullable: true
          example: null
        created_at:
          type: string
          example: '2026-07-25 10:00:00'
    MessageInfo:
      allOf:
        -
          $ref: '#/components/schemas/Message'
    SendMessageRequest:
      type: object
      required:
        - body
        - receiver_id
      properties:
        body:
          type: string
          example: 'Hello, how are you?'
        receiver_id:
          type: integer
          description: 'The ID of the user receiving the message. A conversation will be found or created between the authenticated user and this receiver.'
          example: 2
    CurrencyDTO:
      type: object
      required:
        - code
        - name
        - decimal_places
        - is_active
      properties:
        code:
          type: string
          maxLength: 255
          description: 'Unique currency ISO code, used as identifier.'
          example: USD
        name:
          type: string
          maxLength: 255
          example: 'US Dollar'
        symbol:
          type: string
          nullable: true
          example: $
        decimal_places:
          type: integer
          example: 2
        is_active:
          type: boolean
          example: true
    CurrencyUpdateRequest:
      type: object
      properties:
        name:
          type: string
          example: 'US Dollar'
          description: 'Optional. Must be unique.'
        is_active:
          type: boolean
          example: false
    CurrencyConvertRequest:
      type: object
      required:
        - action
        - currency_code
        - amount
      properties:
        action:
          type: string
          enum:
            - to_base
            - from_base
          description: "Conversion direction:\n- `to_base` - convert the given amount **from** `currency_code` to the base currency\n- `from_base` - convert the given amount **from** the base currency to `currency_code`\n"
          example: to_base
        currency_code:
          type: string
          description: 'Target currency ISO code (source currency when action is `to_base`, destination currency when action is `from_base`).'
          example: USD
        amount:
          type: number
          format: double
          minimum: 0
          description: 'Amount to convert, expressed in the source currency of the conversion.'
          example: 100
    CurrencyConvertResult:
      type: object
      properties:
        action:
          type: string
          enum:
            - to_base
            - from_base
          example: to_base
        currency_code:
          type: string
          example: USD
        amount:
          type: number
          format: double
          description: 'The input amount.'
          example: 100
        result:
          type: number
          format: double
          description: 'Converted amount, expressed in the destination currency of the conversion.'
          example: 1400000
    CurrencyInfoResource:
      type: object
      properties:
        code:
          type: string
          example: USD
        name:
          type: string
          example: 'US Dollar'
        is_base:
          type: boolean
          description: 'Whether this currency is the base currency of the system.'
          example: false
        symbol:
          type: string
          nullable: true
          example: $
        decimal_places:
          type: integer
          example: 2
        is_active:
          type: boolean
          example: true
        created_at:
          type: string
          format: date
          example: 20-08-2026
    ExchangeRateDTO:
      type: object
      required:
        - from_currency_code
        - to_currency_code
        - rate
        - effective_date
      properties:
        from_currency_code:
          type: string
          description: 'Code of the currency being converted from. Must exist in currencies.'
          example: USD
        to_currency_code:
          type: string
          description: 'Code of the currency being converted to. Must exist in currencies.'
          example: SYP
        rate:
          type: number
          format: double
          description: 'Conversion rate applied on `effective_date`.'
          example: 13000.5
        effective_date:
          type: string
          format: date
          example: '2026-08-22'
        notes:
          type: string
          nullable: true
          example: 'Official rate'
    ExchangeRateInfoResource:
      type: object
      properties:
        id:
          type: integer
          example: 1
        from_currency_code:
          type: string
          example: USD
        to_currency_code:
          type: string
          example: SYP
        rate:
          type: number
          format: double
          example: 13000.5
        effective_date:
          type: string
          format: date
          example: 22-08-2026
        notes:
          type: string
          nullable: true
          example: 'Official rate'
        created_at:
          type: string
          format: date
          example: 22-08-2026
    PaymentFeeDTO:
      type: object
      required:
        - name
        - code
        - fee_status
        - fee_value
      properties:
        name:
          type: string
          maxLength: 255
          example: 'Maintenance Fee'
        code:
          type: string
          example: MTN-001
        fee_status:
          type: string
          enum:
            - active
            - archived
          example: active
        fee_value:
          type: number
