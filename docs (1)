        -
          name: plotId
          in: path
          required: true
          schema:
            type: integer
        -
          name: subRequestId
          in: path
          required: true
          schema:
            type: integer
          description: 'ID of the subscription request'
      responses:
        200:
          description: 'The materialized plot dossier (with plot, partners, facilities and authorized persons).'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { $ref: '#/components/schemas/PlotDossierInfoResource' } } }
        401:
          $ref: '#/components/responses/Unauthenticated'
