openapi: 3.0.0
info:
  title: 'Marka-ERP API'
  version: 1.0.0
  description: 'Merged API Documentation for all modules'
servers:
  -
    url: /api/v1/
    description: 'Base URL'
paths:
  /shared-kernal/notifications:
    get:
      summary: 'List all notifications for the authenticated user'
      description: 'Returns all database notifications for the authenticated user (read and unread).'
      tags:
        - Notifications
      security:
        -
          sanctumAuth: {  }
      responses:
        200:
          description: 'List of notifications'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { type: array, items: { $ref: '#/components/schemas/Notification' } } } }
        401:
          $ref: '#/components/responses/Unauthenticated'
        500:
          $ref: '#/components/responses/InternalServerError'
  '/shared-kernal/notifications/{notificationId}/read':
    post:
      summary: 'Mark a notification as read'
      description: "Marks a single unread notification as read for the authenticated user.\nIf the notification is not found (or already read), the call still succeeds\nwith an empty `data` array.\n"
      tags:
        - Notifications
      security:
        -
          sanctumAuth: {  }
      parameters:
        -
          name: notificationId
          in: path
          required: true
          description: 'UUID of the notification to mark as read.'
          schema:
            type: string
            format: uuid
            example: 4b1f1e7a-9f6b-4a1c-8a2e-3f5d7c9b2e41
      responses:
        200:
          description: 'Notification marked as read'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SuccessResponseEmptyData'
        401:
          $ref: '#/components/responses/Unauthenticated'
        500:
          $ref: '#/components/responses/InternalServerError'
  /shared-kernal/notifications/read-all:
    post:
      summary: 'Mark all notifications as read'
      description: 'Marks all unread notifications as read for the authenticated user.'
      tags:
        - Notifications
      security:
        -
          sanctumAuth: {  }
      responses:
        200:
          description: 'All notifications marked as read'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SuccessResponseEmptyData'
        401:
          $ref: '#/components/responses/Unauthenticated'
        500:
          $ref: '#/components/responses/InternalServerError'
  /shared-kernal/countries:
    get:
      summary: 'List all countries'
      description: "Send the `Accept-Language` header with `en` or `ar` for translated `name`.\n\nFilter via `search` (name). **Sort (`sort_by[column]=asc|desc`):** `name`, `code`, `created_at` — default `created_at` desc if omitted.\n"
      tags:
        - Countries
      security:
        -
          sanctumAuth: {  }
      parameters:
        -
          $ref: '#/components/parameters/AcceptLanguage'
        -
          $ref: '#/components/parameters/SearchQuery'
        -
          $ref: '#/components/parameters/SortByName'
        -
          $ref: '#/components/parameters/SortByCode'
        -
          $ref: '#/components/parameters/SortByCreatedAt'
      responses:
        200:
          description: 'List of countries'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { type: array, items: { $ref: '#/components/schemas/Country' } } } }
    post:
      summary: 'Create a country'
      tags:
        - Countries
      security:
        -
          sanctumAuth: {  }
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - name
              properties:
                name:
                  type: object
                  required: [en, ar]
                  properties: { en: { type: string, example: 'country name in english' }, ar: { type: string, example: 'اسم الدولة في العربية' } }
                is_default:
                  type: boolean
                  example: false
      responses:
        200:
          description: 'Created successfully'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { $ref: '#/components/schemas/Country' } } }
