    RuleCondition:
      type: object
      description: 'A single leaf condition comparing a field against a value'
      required:
        - type
        - field
        - operator
        - value
      properties:
        type:
          type: string
          enum:
            - condition
          example: condition
        field:
          type: string
          enum:
            - employee_age
            - employee_gender
            - employee_number_of_children
            - employee_years_of_service
            - employee_marital_status
            - employee_job_title
            - employee_contract_type
          example: employee_age
        operator:
          type: string
          enum:
            - '='
            - '!='
            - '>'
            - '>='
            - '<'
            - '<='
            - IN
            - 'NOT IN'
            - BETWEEN
          example: '>='
        value:
          description: 'The value to compare against (type depends on the field)'
    RuleGroup:
      type: object
      description: 'A recursive group of conditions joined by AND/OR'
      required:
        - type
        - operator
        - conditions
      properties:
        type:
          type: string
          enum:
            - group
          example: group
        operator:
          type: string
          enum:
            - AND
            - OR
          example: AND
        conditions:
          type: array
          items:
            oneOf:
              -
                $ref: '#/components/schemas/RuleCondition'
              -
                $ref: '#/components/schemas/RuleGroup'
    eligibility_rules_example:
      oneOf:
        -
          $ref: '#/components/schemas/RuleCondition'
        -
          $ref: '#/components/schemas/RuleGroup'
      example:
        type: group
        operator: AND
        conditions:
          -
            type: condition
            field: employee_contract_type
            operator: '='
            value: permanent
          -
            type: group
            operator: OR
            conditions:
              -
                type: condition
                field: employee_years_of_service
                operator: '>='
                value: 5
              -
                type: condition
                field: employee_job_title
                operator: '='
                value: Manager
    entitlement_rules:
      type: object
      description: "Entitlement rule definitions.\nAccepts one of two structures: `bands` (tiered bands with rule-based matching) or `fixed` (flat grant).\nFor now only the `bands` structure is used.\n"
      oneOf:
        -
          $ref: '#/components/schemas/entitlement_rules.bands_case'
        -
          $ref: '#/components/schemas/entitlement_rules.fixed_grant_case'
    entitlement_rules.bands_case:
      type: object
      description: "Tiered bands — the first band whose rule matches determines the grant.\n"
      properties:
        type:
          type: string
          enum:
            - bands
          example: bands
        bands:
          type: array
          items:
            type: object
            properties:
              rule:
                $ref: '#/components/schemas/RuleGroup'
              grant:
                type: object
                properties:
                  value: { type: number, example: 21 }
                  unit: { type: string, enum: [day, hour], example: day }
      example:
        type: bands
        bands:
          -
            rule:
              type: group
              operator: AND
              conditions:
                -
                  type: condition
                  field: employee_years_of_service
                  operator: '<'
                  value: 5
            grant:
              value: 15
              unit: day
          -
            rule:
              type: group
              operator: AND
              conditions:
                -
                  type: condition
                  field: employee_years_of_service
                  operator: '>='
                  value: 5
                -
                  type: condition
                  field: employee_years_of_service
                  operator: '<'
                  value: 10
            grant:
              value: 21
              unit: day
          -
            rule:
              type: group
              operator: AND
              conditions:
                -
                  type: condition
                  field: employee_years_of_service
                  operator: '>='
                  value: 10
            grant:
              value: 30
              unit: day
    entitlement_rules.fixed_grant_case:
      type: object
      description: 'Fixed grant for all employees who meet eligibility criteria'
      properties:
        type:
          type: string
          enum:
            - fixed
          example: fixed
        grant:
          type: object
          properties:
            value:
              type: number
              example: 90
            unit:
              type: string
              enum:
                - day
                - hour
              example: day
      example:
        type: fixed
        grant:
          value: 90
          unit: day
