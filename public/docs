  /shared-kernal/countries:
    get:
      summary: 'List all countries'
      description: 'Send the `Accept-Language` header with `en` or `ar` to control the returned translated country name.'
      tags:
        - Countries
      security:
        -
          sanctumAuth: {  }
      parameters:
        -
          name: Accept-Language
          in: header
          required: false
          description: 'Response language for translated fields like `name`'
          schema:
            type: string
            enum:
              - en
              - ar
            example: en
      responses:
        200:
          description: 'List of countries'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { type: array, items: { $ref: '#/components/schemas/Country' } } } }
    post:
      summary: 'Create a country'
      tags:
        - Countries
      security:
        -
          sanctumAuth: {  }
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - name
              properties:
                name:
                  type: object
                  required: [en, ar]
                  properties: { en: { type: string, example: 'country name in english' }, ar: { type: string, example: 'اسم الدولة في العربية' } }
      responses:
        200:
          description: 'Created successfully'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { $ref: '#/components/schemas/Country' } } }
  '/shared-kernal/countries/{id}':
    get:
      summary: 'Get country details'
      description: 'Send the `Accept-Language` header with `en` or `ar` to control the returned translated country name.'
      tags:
        - Countries
      security:
        -
          sanctumAuth: {  }
      parameters:
        -
          name: id
          in: path
          required: true
          schema:
            type: integer
        -
          name: Accept-Language
          in: header
          required: false
          description: 'Response language for translated fields like `name`'
          schema:
            type: string
            enum:
              - en
              - ar
            example: ar
      responses:
        200:
          description: 'Country details'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { $ref: '#/components/schemas/Country' } } }
    put:
      summary: 'Update a country'
      tags:
        - Countries
      security:
        -
          sanctumAuth: {  }
      parameters:
        -
          name: id
          in: path
          required: true
          schema:
            type: integer
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
