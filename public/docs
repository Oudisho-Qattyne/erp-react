openapi: 3.0.0
info:
  title: 'Marka-ERP API'
  version: 1.0.0
  description: 'Merged API Documentation for all modules'
servers:
  -
    url: /api/v1/
    description: 'Base URL'
paths:
  /hr/organizational-levels:
    get:
      summary: 'List all organizational levels'
      tags:
        - 'Organizational Levels'
      security:
        -
          sanctumAuth: {  }
      parameters:
        -
          in: query
          name: page
          schema:
            type: integer
            default: 1
        -
          in: query
          name: per_page
          schema:
            type: integer
            default: 10
        -
          in: query
          name: sort_by
          description: 'Sort columns (e.g. sort_by[name]=asc)'
          schema:
            type: object
            additionalProperties:
              type: string
      responses:
        200:
          description: 'List of organizational levels'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { type: array, items: { $ref: '#/components/schemas/OrganizationalLevel' } } } }
        401:
          $ref: '#/components/responses/Unauthenticated'
    post:
      summary: 'Create an organizational level'
      tags:
        - 'Organizational Levels'
      security:
        -
          sanctumAuth: {  }
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - name
              properties:
                name:
                  type: string
                  example: 'Finance Department'
                parent_id:
                  type: integer
                  nullable: true
                  example: null
      responses:
        200:
          description: 'Created successfully'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { $ref: '#/components/schemas/OrganizationalLevel' } } }
        401:
          $ref: '#/components/responses/Unauthenticated'
        422:
          $ref: '#/components/responses/ValidationError'
  '/hr/organizational-levels/{id}':
    get:
      summary: 'Get organizational level details'
      tags:
        - 'Organizational Levels'
      security:
        -
          sanctumAuth: {  }
      parameters:
        -
          name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        200:
          description: 'Organizational level details'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { $ref: '#/components/schemas/OrganizationalLevel' } } }
        401:
          $ref: '#/components/responses/Unauthenticated'
        404:
          $ref: '#/components/responses/NotFound'
    put:
      summary: 'Update an organizational level'
      tags:
        - 'Organizational Levels'
      security:
        -
          sanctumAuth: {  }
      parameters:
        -
          name: id
          in: path
          required: true
          schema:
            type: integer
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                name:
                  type: string
                parent_id:
                  type: integer
                  nullable: true
      responses:
        200:
          description: 'Updated successfully'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { $ref: '#/components/schemas/OrganizationalLevel' } } }
        401:
          $ref: '#/components/responses/Unauthenticated'
        404:
          $ref: '#/components/responses/NotFound'
        422:
          $ref: '#/components/responses/ValidationError'
    delete:
      summary: 'Delete an organizational level'
      tags:
        - 'Organizational Levels'
      security:
        -
          sanctumAuth: {  }
      parameters:
        -
          name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        200:
          description: 'Deleted successfully'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SuccessResponse'
        401:
          $ref: '#/components/responses/Unauthenticated'
        404:
          $ref: '#/components/responses/NotFound'
  /hr/employees:
    get:
      summary: 'List all employees'
      tags:
        - Employees
      security:
        -
          sanctumAuth: {  }
      parameters:
        -
          in: query
          name: search
          description: 'Search by name, personal_id_number, or national_id'
          schema:
            type: string
        -
          in: query
          name: gender
          schema:
            type: string
            enum:
              - male
              - female
        -
          in: query
          name: page
          schema:
            type: integer
            default: 1
        -
          in: query
          name: per_page
          schema:
            type: integer
            default: 10
        -
          in: query
          name: sort_by
          description: 'Sort columns (e.g. sort_by[created_at]=desc)'
          schema:
            type: object
            additionalProperties:
              type: string
      responses:
        200:
          description: 'Paginated list of employees'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { type: array, items: { $ref: '#/components/schemas/EmployeeSummary' } } } }
        401:
          $ref: '#/components/responses/Unauthenticated'
    post:
      summary: 'Create a new employee with full details'
      description: "Creates an employee along with employment details and optional education records in a single atomic transaction.\n"
      tags:
        - Employees
      security:
        -
          sanctumAuth: {  }
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - personal_id_number
                - national_id
                - first_name
                - last_name
                - gender
                - residence_region_id
                - employment_details
              properties:
                personal_id_number:
                  type: string
                  maxLength: 50
                  example: EMP001
                  description: 'Unique self number'
                national_id:
                  type: string
                  maxLength: 20
                  example: '0101010101'
                first_name:
                  type: string
                  example: Ahmad
                father_name:
                  type: string
                  nullable: true
                  example: Khaled
                last_name:
                  type: string
                  example: Hassan
                mother_name:
                  type: string
                  nullable: true
                  example: Fatima
                gender:
                  type: string
                  enum: [male, female]
                  example: male
                date_birth:
                  type: string
                  format: date
                  nullable: true
                  example: '1990-05-15'
                place_birth:
                  type: string
                  nullable: true
                  example: Damascus
                marital_status:
                  type: string
                  enum: [single, married, divorced, widowed]
                  nullable: true
                  example: married
                wives:
                  type: string
                  nullable: true
                  example: 'Nour Hassan'
                spouse_workplace:
                  type: string
                  nullable: true
                  example: 'Ministry of Education'
                blood_type:
                  type: string
                  enum: [A+, A-, B+, B-, AB+, AB-, O+, O-]
                  nullable: true
                  example: O+
                phone_number:
                  type: string
                  nullable: true
                  example: '+963911234567'
                sham_cash_account:
                  type: string
                  nullable: true
                  example: SC-001234
                residence_region_id:
                  type: integer
                  example: 5
                residential_area_details:
                  type: string
                  nullable: true
                  example: 'Building 12, Floor 3'
                civil_registry_record:
                  type: string
                  nullable: true
                  example: 12345/A
                health_status:
                  type: string
                  nullable: true
                  example: Healthy
                injury_details:
                  type: string
                  nullable: true
                  example: null
                injury_date:
                  type: string
                  format: date
                  nullable: true
                  example: null
                employment_details:
                  type: object
                  required: [org_unit_id, status, workplace_residence_city_id]
                  properties: { job_title: { type: string, nullable: true, example: 'Software Engineer' }, org_unit_id: { type: integer, example: 1 }, status: { type: string, enum: [active, inactive, suspended], example: active }, appointment_date: { type: string, format: date, nullable: true, example: '2022-03-15' }, contract_type: { type: string, nullable: true, example: Full-time }, contract_nature: { type: string, nullable: true, example: Permanent }, job_category: { type: string, nullable: true, example: Engineering }, workplace_residence_city_id: { type: integer, example: 14 } }
                educations:
                  type: array
                  nullable: true
                  items: { type: object, required: [category], properties: { category: { type: string, enum: [initial, adjusted, latest, current], example: latest }, degree_name: { type: string, nullable: true, example: 'Bachelor of Science' }, university_id: { type: integer, nullable: true, example: 1 }, faculty_id: { type: integer, nullable: true, example: 1 }, specialization_id: { type: integer, nullable: true, example: 1 }, graduation_year: { type: integer, nullable: true, example: 2020 }, academic_stage: { type: string, nullable: true, example: null }, study_status: { type: string, nullable: true, example: null } } }
      responses:
        200:
          description: 'Employee created successfully'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { $ref: '#/components/schemas/EmployeeInfo' } } }
        401:
          $ref: '#/components/responses/Unauthenticated'
        422:
          $ref: '#/components/responses/ValidationError'
  '/hr/employees/{id}':
    get:
      summary: 'Get full employee details'
      description: 'Returns employee with employment details, education records, and residence region.'
      tags:
        - Employees
      security:
        -
          sanctumAuth: {  }
      parameters:
        -
          name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        200:
          description: 'Employee full details'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { $ref: '#/components/schemas/EmployeeInfo' } } }
        401:
          $ref: '#/components/responses/Unauthenticated'
        404:
          $ref: '#/components/responses/NotFound'
    put:
      summary: 'Update employee record'
      description: "Updates employee fields. Nested objects (`employment_details`, `educations`) are optional.\n- Providing `employment_details` will upsert the related record.\n- Providing `educations` will **replace** all existing education records.\n"
      tags:
        - Employees
      security:
        -
          sanctumAuth: {  }
      parameters:
        -
          name: id
          in: path
          required: true
          schema:
            type: integer
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                first_name:
                  type: string
                father_name:
                  type: string
                  nullable: true
                last_name:
                  type: string
                gender:
                  type: string
                  enum: [male, female]
                date_birth:
                  type: string
                  format: date
                  nullable: true
                marital_status:
                  type: string
                  enum: [single, married, divorced, widowed]
                  nullable: true
                phone_number:
                  type: string
                  nullable: true
                residence_region_id:
                  type: integer
                employment_details:
                  type: object
                  properties: { job_title: { type: string, nullable: true }, org_unit_id: { type: integer }, status: { type: string, enum: [active, inactive, suspended] }, workplace_residence_city_id: { type: integer } }
                educations:
                  type: array
                  nullable: true
                  items: { $ref: '#/components/schemas/Education' }
      responses:
        200:
          description: 'Employee updated successfully'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { $ref: '#/components/schemas/EmployeeInfo' } } }
        401:
          $ref: '#/components/responses/Unauthenticated'
        404:
          $ref: '#/components/responses/NotFound'
        422:
          $ref: '#/components/responses/ValidationError'
    delete:
      summary: 'Soft-delete an employee'
      tags:
        - Employees
      security:
        -
          sanctumAuth: {  }
      parameters:
        -
          name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        200:
          description: 'Employee soft-deleted successfully'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SuccessResponse'
        401:
          $ref: '#/components/responses/Unauthenticated'
        404:
          $ref: '#/components/responses/NotFound'
  /users/login:
    post:
      summary: 'User login'
      description: 'Authenticate user and return a Sanctum token.'
      tags:
        - 'Users Module'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - email
                - password
              properties:
                email:
                  type: string
                  format: email
                  example: admin@example.com
                password:
                  type: string
                  format: password
                  example: password123
      responses:
        200:
          description: 'Login successful'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { type: object, properties: { user: { $ref: '#/components/schemas/User' }, token: { type: string, example: 1|abcdef1234567890abcdef1234567890 } } } } }
        422:
          description: 'Validation error'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ValidationErrorResponse'
  /users/:
    get:
      summary: 'List all users'
      tags:
        - 'Users Module'
      security:
        -
          sanctumAuth: {  }
      parameters:
        -
          in: query
          name: page
          schema:
            type: integer
          description: 'Page number'
        -
          in: query
          name: per_page
          schema:
            type: integer
          description: 'Items per page'
      responses:
        200:
          description: 'List of users'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { type: array, items: { $ref: '#/components/schemas/User' } } } }
        401:
          $ref: '#/components/responses/Unauthenticated'
        403:
          $ref: '#/components/responses/Forbidden'
  /users/current:
    get:
      summary: 'Get current authenticated user info'
      tags:
        - 'Users Module'
      security:
        -
          sanctumAuth: {  }
      responses:
        200:
          description: 'Current user info'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { $ref: '#/components/schemas/User' } } }
        401:
          $ref: '#/components/responses/Unauthenticated'
        403:
          $ref: '#/components/responses/Forbidden'
  '/users/{id}':
    post:
      summary: 'Update a user'
      tags:
        - 'Users Module'
      security:
        -
          sanctumAuth: {  }
      parameters:
        -
          name: id
          in: path
          required: true
          schema:
            type: string
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                name:
                  type: string
                mobile:
                  type: string
                status:
                  type: string
                role:
                  type: string
      responses:
        200:
          description: 'User updated successfully'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { $ref: '#/components/schemas/User' } } }
        401:
          $ref: '#/components/responses/Unauthenticated'
        403:
          $ref: '#/components/responses/Forbidden'
        422:
          description: 'Validation error'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ValidationErrorResponse'
  /users/signature:
    post:
      summary: 'Update user signature'
      tags:
        - 'Users Module'
      security:
        -
          sanctumAuth: {  }
      requestBody:
        content:
          multipart/form-data:
            schema:
              type: object
              properties:
                signature:
                  type: string
                  format: binary
      responses:
        200:
          description: 'Signature updated successfully'
          content:
            application/json:
              schema:
                allOf:
                  - { $ref: '#/components/schemas/SuccessResponse' }
                  - { type: object, properties: { data: { $ref: '#/components/schemas/User' } } }
        401:
          $ref: '#/components/responses/Unauthenticated'
        403:
          $ref: '#/components/responses/Forbidden'
  /users/reports/excel:
    post:
      summary: 'Export users to Excel'
      tags:
        - 'Users Module'
      security:
